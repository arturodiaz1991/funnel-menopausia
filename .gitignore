# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database
/db/*.db
/db/*.db-wal
/db/*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# design references (local only, no subir a produccion)
/design-references/*.jpg
/design-references/*.jpeg
/design-references/*.png
/design-references/*.webp
/design-references/*.gif
/design-references/*.pdf

# --- Seguridad (añadido el 2026-11-10 antes de subir a GitHub): claves, sesiones y dependencias ---
.env
.env.*
!.env.*.example
*.key
*.p12
*.pfx
id_rsa*
client_secret*.json
token.json
.session/
browser_profile/
**/Cookies
**/Cookies-journal
.playwright-mcp/
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.vercel/
